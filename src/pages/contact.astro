---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contact Us — Support & Feedback | FreeExamTimer"
  description="Contact the FreeExamTimer team for feature requests, exam hall feedback, school deployment questions, or bug reports. 100% free educational timer."
  canonicalUrl="https://freeexamtimer.com/contact"
>
  <Nav active="contact" />

  <main class="mx-auto max-w-[840px] px-5 pt-24 pb-20">
    <!-- Header -->
    <div class="mb-12">
      <p class="eyebrow">Get In Touch</p>
      <h1 class="mt-2 text-[36px] md:text-[44px] leading-[44px] font-semibold tracking-[-2px]">
        Contact Us
      </h1>
      <p class="mt-4 text-base md:text-lg leading-relaxed text-[var(--text-secondary)]">
        Have suggestions for our exam clock, found an issue on your projector setup, or want to share feedback from your examination hall? We'd love to hear from you.
      </p>
    </div>

    <!-- Contact Cards Grid -->
    <div class="grid gap-6 sm:grid-cols-3 mb-12">
      <div class="card p-5 bg-[var(--bg-elevated)]">
        <div class="h-8 w-8 rounded-lg bg-[var(--text-primary)] text-[var(--bg-primary)] flex items-center justify-center mb-3">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </div>
        <h2 class="text-sm font-semibold text-[var(--text-primary)]">General Support</h2>
        <p class="mt-1 text-xs text-[var(--text-secondary)] leading-5">Questions about setup or exam modes.</p>
        <a href="mailto:support@freeexamtimer.com" class="mt-3 inline-block text-xs font-mono font-medium text-[var(--color-link)] hover:underline">
          support@freeexamtimer.com
        </a>
      </div>

      <div class="card p-5 bg-[var(--bg-elevated)]">
        <div class="h-8 w-8 rounded-lg bg-[var(--text-primary)] text-[var(--bg-primary)] flex items-center justify-center mb-3">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
          </svg>
        </div>
        <h2 class="text-sm font-semibold text-[var(--text-primary)]">School Districts</h2>
        <p class="mt-1 text-xs text-[var(--text-secondary)] leading-5">Institutional inquiries and custom rules.</p>
        <a href="mailto:schools@freeexamtimer.com" class="mt-3 inline-block text-xs font-mono font-medium text-[var(--color-link)] hover:underline">
          schools@freeexamtimer.com
        </a>
      </div>

      <div class="card p-5 bg-[var(--bg-elevated)]">
        <div class="h-8 w-8 rounded-lg bg-[var(--text-primary)] text-[var(--bg-primary)] flex items-center justify-center mb-3">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
          </svg>
        </div>
        <h2 class="text-sm font-semibold text-[var(--text-primary)]">Feature Requests</h2>
        <p class="mt-1 text-xs text-[var(--text-secondary)] leading-5">Suggest bells, presets, or shortcuts.</p>
        <a href="mailto:feedback@freeexamtimer.com" class="mt-3 inline-block text-xs font-mono font-medium text-[var(--color-link)] hover:underline">
          feedback@freeexamtimer.com
        </a>
      </div>
    </div>

    <!-- Contact Form Section -->
    <div class="card p-6 md:p-8 bg-[var(--bg-card)]">
      <div id="form-container">
        <h2 class="text-xl font-semibold text-[var(--text-primary)] tracking-tight">
          Send Us a Message
        </h2>
        <p class="mt-1 text-sm text-[var(--text-secondary)]">
          Fill out the form below. We typically respond within 24 to 48 hours on school days.
        </p>

        <form id="contact-form" class="mt-6 space-y-5">
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="contact-name" class="block text-xs font-medium text-[var(--text-secondary)] mb-1.5 uppercase font-mono tracking-wider">
                Your Name <span class="text-rose-500">*</span>
              </label>
              <input
                id="contact-name"
                name="name"
                type="text"
                required
                placeholder="e.g. Dr. Sarah Jenkins"
                class="field text-sm"
              />
            </div>
            <div>
              <label for="contact-email" class="block text-xs font-medium text-[var(--text-secondary)] mb-1.5 uppercase font-mono tracking-wider">
                Email Address <span class="text-rose-500">*</span>
              </label>
              <input
                id="contact-email"
                name="email"
                type="email"
                required
                placeholder="s.jenkins@school.edu"
                class="field text-sm"
              />
            </div>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="contact-role" class="block text-xs font-medium text-[var(--text-secondary)] mb-1.5 uppercase font-mono tracking-wider">
                Your Role
              </label>
              <select id="contact-role" name="role" class="field text-sm">
                <option value="teacher">Teacher / Educator</option>
                <option value="invigilator">Exam Invigilator / Proctor</option>
                <option value="exam-officer">Exam Officer / Coordinator</option>
                <option value="student">Student / Candidate</option>
                <option value="parent">Parent / Tutor</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div>
              <label for="contact-subject" class="block text-xs font-medium text-[var(--text-secondary)] mb-1.5 uppercase font-mono tracking-wider">
                Subject
              </label>
              <select id="contact-subject" name="subject" class="field text-sm">
                <option value="feature">Feature Request or Suggestion</option>
                <option value="hall-feedback">Exam Hall Experience Feedback</option>
                <option value="bug">Report a Display or Audio Bug</option>
                <option value="school">School / District Inquiries</option>
                <option value="other">General Question</option>
              </select>
            </div>
          </div>

          <div>
            <label for="contact-message" class="block text-xs font-medium text-[var(--text-secondary)] mb-1.5 uppercase font-mono tracking-wider">
              Message <span class="text-rose-500">*</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              required
              placeholder="Tell us what you need, what examination format you are administering, or how we can improve FreeExamTimer..."
              class="field text-sm resize-y"
            ></textarea>
          </div>

          <div class="flex items-center justify-between pt-2">
            <p class="text-xs text-[var(--text-muted)]">
              Zero spam pledge. Your email will never be sold or shared.
            </p>
            <button type="submit" id="contact-submit-btn" class="btn-pill shrink-0">
              <span>Send Message</span>
              <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </button>
          </div>
        </form>
      </div>

      <!-- Success State Message (Initially Hidden) -->
      <div id="contact-success" class="hidden text-center py-10">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-500 mb-4">
          <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-[var(--text-primary)]">Message Dispatched!</h3>
        <p class="mt-2 text-sm text-[var(--text-secondary)] max-w-md mx-auto">
          Thank you for reaching out. We have received your submission and our team of educators will get back to you shortly.
        </p>
        <div class="mt-6 flex justify-center gap-3">
          <button type="button" id="contact-reset-btn" class="btn-app">Send another message</button>
          <a href="/" class="btn-pill">Back to exam timer</a>
        </div>
      </div>
    </div>

    <!-- Quick Help Card -->
    <div class="card mt-12 p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <p class="font-medium text-[var(--text-primary)]">Looking for answers immediately?</p>
        <p class="mt-1 text-sm text-[var(--text-secondary)]">
          Check out our frequently asked questions for quick solutions to audio, projector, and extra-time queries.
        </p>
      </div>
      <a href="/faq" class="btn-app shrink-0">Visit FAQ</a>
    </div>
  </main>

  <Footer />

  <script is:inline>
    (function() {
      const form = document.getElementById('contact-form');
      const container = document.getElementById('form-container');
      const success = document.getElementById('contact-success');
      const resetBtn = document.getElementById('contact-reset-btn');
      const submitBtn = document.getElementById('contact-submit-btn');

      if (!form || !container || !success) return;

      form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        // Show loading state on button
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = 'Sending...';
        }

        setTimeout(function() {
          form.reset();
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Send Message</span>';
          }
          container.classList.add('hidden');
          success.classList.remove('hidden');
        }, 600);
      });

      if (resetBtn) {
        resetBtn.addEventListener('click', function() {
          success.classList.add('hidden');
          container.classList.remove('hidden');
        });
      }
    })();
  </script>
</Layout>
