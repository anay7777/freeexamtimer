---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="About Us — The Story Behind FreeExamTimer | FreeExamTimer"
  description="Learn about FreeExamTimer: an ad-free, hall-ready countdown clock created by educators for teachers, invigilators, schools, and students worldwide."
  canonicalUrl="https://freeexamtimer.com/about"
>
  <Nav active="about" />

  <main class="mx-auto max-w-[840px] px-5 pt-24 pb-20">
    <!-- Header -->
    <div class="mb-12">
      <p class="eyebrow">About FreeExamTimer</p>
      <h1 class="mt-2 text-[36px] md:text-[48px] leading-[44px] md:leading-[52px] font-semibold tracking-[-2px]">
        Built for teachers.<br class="hidden sm:inline" /> Trusted in high-stakes exam halls.
      </h1>
      <p class="mt-4 text-base md:text-lg leading-relaxed text-[var(--text-secondary)]">
        FreeExamTimer was created out of a simple observation: teachers and invigilators were forced to rely on clunky cooking timers, ad-infested websites, or manual whiteboard math during crucial examinations.
      </p>
    </div>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16">
      <div class="card p-5 text-center">
        <p class="font-mono text-3xl font-semibold text-[var(--text-primary)]">0</p>
        <p class="mt-1 text-xs text-[var(--text-secondary)] uppercase tracking-wider font-mono">Ads or Trackers</p>
      </div>
      <div class="card p-5 text-center">
        <p class="font-mono text-3xl font-semibold text-[var(--text-primary)]">30m+</p>
        <p class="mt-1 text-xs text-[var(--text-secondary)] uppercase tracking-wider font-mono">Projection Range</p>
      </div>
      <div class="card p-5 text-center">
        <p class="font-mono text-3xl font-semibold text-[var(--text-primary)]">+25%</p>
        <p class="mt-1 text-xs text-[var(--text-secondary)] uppercase tracking-wider font-mono">Auto Extra Time</p>
      </div>
      <div class="card p-5 text-center">
        <p class="font-mono text-3xl font-semibold text-[var(--text-primary)]">100%</p>
        <p class="mt-1 text-xs text-[var(--text-secondary)] uppercase tracking-wider font-mono">Free Forever</p>
      </div>
    </div>

    <!-- Story / Mission Sections -->
    <div class="space-y-12 text-[var(--text-secondary)] leading-relaxed">
      <section>
        <h2 class="text-2xl font-semibold text-[var(--text-primary)] tracking-tight">
          The Problem with Existing Timers
        </h2>
        <p class="mt-3 text-sm md:text-base leading-7">
          When projecting a clock onto a giant auditorium screen or classroom board, the last thing candidates should see is a video ad, flashing sidebar banner, or sudden pop-up asking for cookie consent. Moreover, standard timers don't know the rules of formal examinations: they don't support official reading time phases, and they don't calculate access arrangement extra time for students with special educational needs.
        </p>
      </section>

      <!-- Hall Features Featurettes -->
      <section>
        <h2 class="text-2xl font-semibold text-[var(--text-primary)] tracking-tight mb-6">
          Engineered for Exam Hall Demands
        </h2>
        <div class="grid gap-6 md:grid-cols-2">
          <div class="card p-6 bg-[var(--bg-elevated)]">
            <div class="h-8 w-8 rounded-lg bg-[var(--text-primary)] text-[var(--bg-primary)] flex items-center justify-center mb-4">
              <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h3 class="text-base font-semibold text-[var(--text-primary)]">Dedicated Reading Time</h3>
            <p class="mt-2 text-sm leading-6">
              Full support for 5, 10, or 15 minutes of initial reading time. Displays unmistakable notices that writing is forbidden, before auto-transitioning with a calm chime.
            </p>
          </div>

          <div class="card p-6 bg-[var(--bg-elevated)]">
            <div class="h-8 w-8 rounded-lg bg-[var(--text-primary)] text-[var(--bg-primary)] flex items-center justify-center mb-4">
              <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
            </div>
            <h3 class="text-base font-semibold text-[var(--text-primary)]">Dual Finish Clocks (+25% Extra Time)</h3>
            <p class="mt-2 text-sm leading-6">
              Automatically calculates JCQ and standard access arrangements. Candidates and invigilators see both the standard paper finish time and the +25% finish time simultaneously.
            </p>
          </div>

          <div class="card p-6 bg-[var(--bg-elevated)]">
            <div class="h-8 w-8 rounded-lg bg-[var(--text-primary)] text-[var(--bg-primary)] flex items-center justify-center mb-4">
              <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
            </div>
            <h3 class="text-base font-semibold text-[var(--text-primary)]">Anxiety Reduction Mode</h3>
            <p class="mt-2 text-sm leading-6">
              Rapidly counting seconds can induce unnecessary panic during early exam hours. Our optional setting hides seconds until the final 5 minutes, fostering a calm exam atmosphere.
            </p>
          </div>

          <div class="card p-6 bg-[var(--bg-elevated)]">
            <div class="h-8 w-8 rounded-lg bg-[var(--text-primary)] text-[var(--bg-primary)] flex items-center justify-center mb-4">
              <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
            </div>
            <h3 class="text-base font-semibold text-[var(--text-primary)]">One-Key Projector Mode</h3>
            <p class="mt-2 text-sm leading-6">
              Press <kbd>F</kbd> for instant full-screen projection. All non-essential navigation controls fade into the background, leaving a stark, ultra-legible display visible across the entire hall.
            </p>
          </div>
        </div>
      </section>

      <!-- Exam Standards -->
      <section>
        <h2 class="text-2xl font-semibold text-[var(--text-primary)] tracking-tight">
          Supporting Global Examination Boards
        </h2>
        <p class="mt-3 text-sm md:text-base leading-7">
          FreeExamTimer is routinely used across schools and test preparation centers preparing for major global examination formats, including:
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          {['SAT & ACT', 'AP Examinations', 'IB Diploma', 'GCSE & A-Levels', 'Cambridge Assessment', 'IELTS & TOEFL', 'JEE Main & Adv', 'NEET (UG)', 'GRE & GMAT', 'UPSC Prelims', 'Gaokao', 'ENEM Brazil', 'HSC / VCE Australia'].map(board => (
            <span class="rounded-full border border-[var(--border-color)] bg-[var(--bg-elevated)] px-3 py-1 text-xs font-mono text-[var(--text-secondary)]">
              {board}
            </span>
          ))}
        </div>
      </section>

      <!-- Open & Accessible Pledge -->
      <section class="card p-6 border-l-4 border-l-blue-500">
        <h2 class="text-lg font-semibold text-[var(--text-primary)]">Our Promise to Education</h2>
        <p class="mt-2 text-sm leading-6">
          FreeExamTimer is maintained as an open digital public utility. We will never add subscription fees, paywall essential exam hall capabilities, or sell candidate data. If you have feature suggestions or custom school requirements, we welcome your feedback.
        </p>
      </section>
    </div>

    <!-- Bottom Actions -->
    <div class="card mt-12 p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <p class="font-medium text-[var(--text-primary)]">Ready to conduct your test?</p>
        <p class="mt-1 text-sm text-[var(--text-secondary)]">
          Launch the full-screen timer or browse our step-by-step setup guide.
        </p>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <a href="/how-to" class="btn-app">How to use</a>
        <a href="/" class="btn-pill">Launch timer</a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
