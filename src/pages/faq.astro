---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { faqItems } from '../data/faq';
---

<Layout
  title="Frequently Asked Questions — Free Online Exam Timer | FreeExamTimer"
  description="Common questions and answers about FreeExamTimer: countdowns for SAT, GCSE, IELTS, maths exam timer, PC and phone support, reading time, extra time, and no-download browser timer."
  canonicalUrl="https://freeexamtimer.com/faq"
  includeFaq={true}
>
  <Nav active="faq" />
  <main class="mx-auto max-w-[760px] px-5 pt-24 pb-20">
    <p class="eyebrow">Help & FAQ</p>
    <h1 class="mt-2 text-[36px] md:text-[44px] leading-[44px] font-semibold tracking-[-2px]">
      Frequently Asked Questions
    </h1>
    <p class="mt-4 text-base leading-6 text-[var(--text-secondary)]">
      Find quick answers to common questions about using FreeExamTimer for tests, classroom examinations, and high-stakes exam halls.
    </p>

    <div class="mt-10">
      <dl class="seo-faq flex flex-col gap-7">
        {faqItems.map((item) => (
          <div>
            <dt class="text-[16px] font-semibold text-[var(--text-primary)]">
              {item.question}
            </dt>
            <dd class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)] pl-4 border-l-2 border-[var(--border-color)]">
              {item.answer}
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="card mt-12 p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <p class="font-medium">Ready to start your exam countdown?</p>
        <p class="mt-1 text-sm text-[var(--text-secondary)]">
          FreeExamTimer is 100% free with no signup, no ads, and full hall projection support.
        </p>
      </div>
      <a href="/" class="btn-pill shrink-0">Open exam timer</a>
    </div>
  </main>
  <Footer />
</Layout>
