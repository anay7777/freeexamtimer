---
import "../styles/global.css";
import { faqItems } from "../data/faq";

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  includeFaq?: boolean;
}

const {
  title = "Free Exam Timer — Free Online Exam Countdown Clock | FreeExamTimer",
  description = "Free exam timer for teachers, invigilators & students. Set reading time, writing time, extra time (+25%), full-screen hall display, and audible chimes. Works for SAT, GRE, IELTS, JEE, NEET, GCSE, IB & more. No ads, no signup.",
  canonicalUrl = "https://freeexamtimer.com/",
  ogImage = "https://freeexamtimer.com/og-image.png",
  includeFaq = false,
} = Astro.props;

const siteName = "FreeExamTimer";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer,
    },
  })),
};
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-PR06TZJDS0"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-PR06TZJDS0');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="FreeExamTimer" />
    <meta
      name="keywords"
      content="exam timer, free exam timer, online exam timer, exam timer clock, exam timer countdown, exam timer full screen, exam timer with extra time, exam timer with reading time, digital exam timer, competitive exam timer, math exam timer, SAT exam timer, GRE exam timer, CAT exam timer, JEE exam timer, NEET exam timer, CLAT exam timer, UPSC exam timer, ACT exam timer, GCSE exam timer, Gaokao exam timer, ENEM exam timer, IELTS exam timer, AP exam timer, IB exam timer, reading time timer, invigilator timer, hall timer, classroom exam clock, exam countdown clock"
    />

    <!-- Canonical & Sitemap -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />


    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="FreeExamTimer — Free Online Exam Countdown Clock"
    />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="twitter:image:alt"
      content="FreeExamTimer — Free Online Exam Countdown Clock"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="FreeExamTimer" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Schema.org WebApplication -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "@id": "https://freeexamtimer.com/#webapp",
        "name": "FreeExamTimer",
        "url": "https://freeexamtimer.com/",
        "description": "Free online exam timer for teachers, invigilators and students. Features reading time, writing time, extra time (+25% access arrangements), full-screen hall display, audible chimes, and shareable exam links.",
        "applicationCategory": "EducationalApplication",
        "operatingSystem": "Any",
        "browserRequirements": "Requires a modern web browser with JavaScript enabled",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "featureList": [
          "Exam countdown timer",
          "Reading time phase with auto-handoff",
          "Extra time / access arrangements (+25%)",
          "Full-screen projector hall display",
          "Audible chimes and warning alerts",
          "Shareable exam configuration links",
          "Digital exam timer with dark mode",
          "Supports SAT, GRE, IELTS, JEE, NEET, GCSE, IB, CAT, CLAT, UPSC, ACT, Gaokao, ENEM, AP exams"
        ],
        "publisher": {
          "@type": "Organization",
          "name": "FreeExamTimer",
          "url": "https://freeexamtimer.com/"
        }
      }
    </script>

    <!-- Schema.org FAQPage -->
    {includeFaq && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(faqJsonLd, null, 2)}
      />
    )}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Theme flash prevention and universal theme controller -->
    <script is:inline>
      (function () {
        function getSavedTheme() {
          try {
            const saved = localStorage.getItem("fet-theme");
            if (saved === "dark" || saved === "light") return saved;
            if (window.matchMedia("(prefers-color-scheme: dark)").matches) return "dark";
          } catch (e) {}
          return "light";
        }

        const initialTheme = getSavedTheme();
        document.documentElement.setAttribute("data-theme", initialTheme);

        function syncThemeUi(theme) {
          const dark = theme === "dark";
          document.querySelectorAll("#icon-sun, .theme-icon-sun").forEach(function (el) {
            el.classList.toggle("hidden", !dark);
          });
          document.querySelectorAll("#icon-moon, .theme-icon-moon").forEach(function (el) {
            el.classList.toggle("hidden", dark);
          });
          var toggle = document.getElementById("toggle-dark");
          if (toggle && "checked" in toggle) {
            toggle.checked = dark;
          }
          document.querySelectorAll("[data-theme-label]").forEach(function (el) {
            el.textContent = dark ? "Dark" : "Light";
          });
        }

        window.__applyTheme = function (theme) {
          document.documentElement.setAttribute("data-theme", theme);
          try {
            localStorage.setItem("fet-theme", theme);
          } catch (e) {}
          syncThemeUi(theme);
          window.dispatchEvent(new CustomEvent("themechange", { detail: { theme: theme } }));
        };

        window.__toggleTheme = function () {
          const current = document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
          const next = current === "dark" ? "light" : "dark";
          window.__applyTheme(next);
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", function () {
            syncThemeUi(document.documentElement.getAttribute("data-theme") || "light");
          });
        } else {
          syncThemeUi(initialTheme);
        }

        // Global click handler for theme toggles
        document.addEventListener("click", function (e) {
          var target = e.target;
          if (!target || !(target instanceof Element)) return;
          var btn = target.closest("#btn-theme, [data-theme-toggle]");
          if (btn) {
            e.preventDefault();
            e.stopPropagation();
            window.__toggleTheme();
            return;
          }

          // Back to top handler
          var backToTop = target.closest("#btn-back-to-top");
          if (backToTop) {
            e.preventDefault();
            window.scrollTo({ top: 0, behavior: "smooth" });
          }
        });

        // Global keyboard shortcut 'D' outside form inputs
        window.addEventListener("keydown", function (e) {
          if (e.defaultPrevented || e.ctrlKey || e.metaKey || e.altKey) return;
          var tag = (e.target && e.target.tagName) || "";
          if (tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT") return;
          if (e.code === "KeyD") {
            e.preventDefault();
            window.__toggleTheme();
          }
        });
      })();
    </script>
  </head>
  <body class="bg-[var(--bg-primary)] text-[var(--text-primary)]">
    <slot />
  </body>
</html>
