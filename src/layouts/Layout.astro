---
import "../styles/global.css";
import { languages, defaultLang, ogLocales, type Lang } from "../i18n/ui";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  /** Language-neutral route (e.g. "/faq/") for pages that exist in every language; enables hreflang alternates. */
  i18nPath?: string;
  ogImage?: string;
  includeFaq?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const absoluteUrl = (path: string) => new URL(path, Astro.site).href;

const {
  title = t.meta.home.title,
  description = t.meta.home.description,
  i18nPath,
  ogImage = "https://freeexamtimer.com/og-image.png",
  includeFaq = false,
} = Astro.props;

const canonicalUrl = i18nPath
  ? absoluteUrl(translatePath(i18nPath))
  : (Astro.props.canonicalUrl ?? "https://freeexamtimer.com/");

const alternates = i18nPath
  ? (Object.keys(languages) as Lang[]).map((l) => ({
      hreflang: l,
      href: absoluteUrl(translatePath(i18nPath, l)),
    }))
  : [];

const siteName = "FreeExamTimer";
const homeUrl = absoluteUrl(translatePath("/"));

const webAppJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": `${homeUrl}#webapp`,
  "name": "FreeExamTimer",
  "url": homeUrl,
  "inLanguage": lang,
  "description": t.meta.schemaDescription,
  "applicationCategory": "EducationalApplication",
  "operatingSystem": "Any",
  "browserRequirements": "Requires a modern web browser with JavaScript enabled",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
  },
  "featureList": t.meta.schemaFeatures,
  "publisher": {
    "@type": "Organization",
    "name": "FreeExamTimer",
    "url": "https://freeexamtimer.com/",
  },
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "inLanguage": lang,
  "mainEntity": t.faq.items.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer,
    },
  })),
};
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-0WBY5V1Y3Y"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-0WBY5V1Y3Y');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="FreeExamTimer" />
    <meta name="keywords" content={t.meta.keywords} />

    <!-- Canonical & Sitemap -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Language alternates (hreflang) -->
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    {i18nPath && (
      <link rel="alternate" hreflang="x-default" href={absoluteUrl(useTranslatedPath(defaultLang)(i18nPath))} />
    )}


    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta property="og:locale" content={ogLocales[lang]} />
    {alternates
      .filter((alt) => alt.hreflang !== lang)
      .map((alt) => (
        <meta property="og:locale:alternate" content={ogLocales[alt.hreflang]} />
      ))}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.meta.ogImageAlt} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="FreeExamTimer" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Schema.org WebApplication -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(webAppJsonLd, null, 2)}
    />

    <!-- Schema.org FAQPage -->
    {includeFaq && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(faqJsonLd, null, 2)}
      />
    )}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Theme flash prevention and universal theme controller -->
    <script is:inline>
      (function () {
        function getSavedTheme() {
          try {
            const saved = localStorage.getItem("fet-theme");
            if (saved === "dark" || saved === "light") return saved;
            if (window.matchMedia("(prefers-color-scheme: dark)").matches) return "dark";
          } catch (e) {}
          return "light";
        }

        const initialTheme = getSavedTheme();
        document.documentElement.setAttribute("data-theme", initialTheme);

        function syncThemeUi(theme) {
          const dark = theme === "dark";
          document.querySelectorAll("#icon-sun, .theme-icon-sun").forEach(function (el) {
            el.classList.toggle("hidden", !dark);
          });
          document.querySelectorAll("#icon-moon, .theme-icon-moon").forEach(function (el) {
            el.classList.toggle("hidden", dark);
          });
          var toggle = document.getElementById("toggle-dark");
          if (toggle && "checked" in toggle) {
            toggle.checked = dark;
          }
          document.querySelectorAll("[data-theme-label]").forEach(function (el) {
            el.textContent = dark ? el.dataset.labelDark || "Dark" : el.dataset.labelLight || "Light";
          });
        }

        window.__applyTheme = function (theme) {
          document.documentElement.setAttribute("data-theme", theme);
          try {
            localStorage.setItem("fet-theme", theme);
          } catch (e) {}
          syncThemeUi(theme);
          window.dispatchEvent(new CustomEvent("themechange", { detail: { theme: theme } }));
        };

        window.__toggleTheme = function () {
          const current = document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
          const next = current === "dark" ? "light" : "dark";
          window.__applyTheme(next);
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", function () {
            syncThemeUi(document.documentElement.getAttribute("data-theme") || "light");
          });
        } else {
          syncThemeUi(initialTheme);
        }

        // Global click handler for theme toggles
        document.addEventListener("click", function (e) {
          var target = e.target;
          if (!target || !(target instanceof Element)) return;
          var btn = target.closest("#btn-theme, [data-theme-toggle]");
          if (btn) {
            e.preventDefault();
            e.stopPropagation();
            window.__toggleTheme();
            return;
          }

          // Back to top handler
          var backToTop = target.closest("#btn-back-to-top");
          if (backToTop) {
            e.preventDefault();
            window.scrollTo({ top: 0, behavior: "smooth" });
          }
        });

        // Global keyboard shortcut 'D' outside form inputs
        window.addEventListener("keydown", function (e) {
          if (e.defaultPrevented || e.ctrlKey || e.metaKey || e.altKey) return;
          var tag = (e.target && e.target.tagName) || "";
          if (tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT") return;
          if (e.code === "KeyD") {
            e.preventDefault();
            window.__toggleTheme();
          }
        });
      })();
    </script>
  </head>
  <body class="bg-[var(--bg-primary)] text-[var(--text-primary)]">
    <slot />
  </body>
</html>
