---
interface Props {
  active?: 'home' | 'how-to' | 'faq' | 'about' | 'contact' | 'privacy' | 'terms' | string;
  examControls?: boolean;
}
import LanguagePicker from './LanguagePicker.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const { active = 'home', examControls = false } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// About and Contact are English-only pages
const links = [
  { id: 'home', href: translatePath('/'), label: t.nav.timer },
  { id: 'how-to', href: translatePath('/how-to/'), label: t.nav.howTo },
  { id: 'faq', href: translatePath('/faq/'), label: t.nav.faq },
  { id: 'about', href: '/about', label: t.nav.about },
  { id: 'contact', href: '/contact', label: t.nav.contact },
];
---

<nav
  class="fixed top-0 right-0 left-0 z-[100] flex h-14 items-center justify-between border-b border-[var(--border-color)] bg-[var(--bg-primary)] px-4 md:px-6"
>
  <a href={translatePath('/')} class="flex items-center gap-2 text-[var(--text-primary)] no-underline">
    <span
      class="flex h-8 w-8 items-center justify-center rounded-[8px] bg-[var(--text-primary)] text-[var(--bg-primary)] transition-colors shadow-xs"
      aria-hidden="true"
    >
      <svg width="18" height="18" viewBox="0 0 512 512" fill="none" stroke="currentColor">
        <!-- Top left bell -->
        <line x1="168" y1="126" x2="112" y2="182" stroke-width="40" stroke-linecap="round" />
        <!-- Top right bell -->
        <line x1="344" y1="126" x2="400" y2="182" stroke-width="40" stroke-linecap="round" />
        <!-- Bottom left leg -->
        <line x1="170" y1="355" x2="138" y2="387" stroke-width="40" stroke-linecap="round" />
        <!-- Bottom right leg -->
        <line x1="342" y1="355" x2="374" y2="387" stroke-width="40" stroke-linecap="round" />
        <!-- Dial circle -->
        <circle cx="256" cy="270" r="114" stroke-width="40" />
        <!-- Hands -->
        <path d="M256 205 V270 L292 304" stroke-width="40" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
    <span class="text-[15px] font-semibold tracking-tight">FreeExamTimer</span>
  </a>

  <div class="hidden items-center gap-1 md:flex">
    {links.map((link) => (
      <a
        href={link.href}
        class:list={[
          'rounded-full px-3 py-2 text-sm transition-colors',
          active === link.id ? 'text-[var(--text-primary)] font-medium' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)]',
        ]}
      >
        {link.label}
      </a>
    ))}
  </div>

  <div class="flex items-center gap-2">
    <LanguagePicker />
    <!-- Hidden on mobile to make room for the language picker; the mobile bottom bar has its own full-screen button -->
    {examControls && (
      <span class="hidden md:contents">
        <button class="btn-app" id="btn-fullscreen" type="button" title={t.nav.fullScreenTitle} aria-label={t.nav.fullScreen}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
          </svg>
        </button>
      </span>
    )}
    <button class="btn-app" id="btn-theme" type="button" title={t.nav.toggleThemeTitle} aria-label={t.nav.toggleTheme}>
      <svg id="icon-sun" class="hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="5"></circle>
        <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
      </svg>
      <svg id="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>
    {examControls && (
      <button class="btn-app" id="btn-settings" type="button" title={t.nav.settings} aria-label={t.nav.settings}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"></circle>
          <path
            d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
          ></path>
        </svg>
      </button>
    )}
  </div>
</nav>
