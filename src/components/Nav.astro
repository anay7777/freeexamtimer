---
interface Props {
  active?: 'home' | 'how-to';
  examControls?: boolean;
}
const { active = 'home', examControls = false } = Astro.props;
---

<nav
  class="fixed top-0 right-0 left-0 z-[100] flex h-14 items-center justify-between border-b border-[var(--border-color)] bg-[var(--bg-primary)] px-4 md:px-6"
>
  <a href="/" class="flex items-center gap-2 text-[var(--text-primary)] no-underline">
    <span
      class="flex h-8 w-8 items-center justify-center rounded-[6px] bg-[var(--text-primary)]"
      aria-hidden="true"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
    </span>
    <span class="text-[15px] font-semibold tracking-tight">FreeExamTimer</span>
  </a>

  <div class="hidden items-center gap-1 md:flex">
    <a
      href="/"
      class:list={[
        'rounded-full px-3 py-2 text-sm',
        active === 'home' ? 'text-[var(--text-primary)]' : 'text-[var(--text-secondary)]',
      ]}>Timer</a
    >
    <a
      href="/how-to"
      class:list={[
        'rounded-full px-3 py-2 text-sm',
        active === 'how-to' ? 'text-[var(--text-primary)]' : 'text-[var(--text-secondary)]',
      ]}>How to use</a
    >
  </div>

  <div class="flex items-center gap-2">
    {examControls && (
      <button class="btn-app" id="btn-fullscreen" type="button" title="Full screen (F)" aria-label="Full screen">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
        </svg>
      </button>
    )}
    <button class="btn-app" id="btn-theme" type="button" title="Toggle theme (D)" aria-label="Toggle theme">
      <svg id="icon-sun" class="hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="5"></circle>
        <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
      </svg>
      <svg id="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>
    {examControls && (
      <button class="btn-app" id="btn-settings" type="button" title="Settings" aria-label="Settings">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"></circle>
          <path
            d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
          ></path>
        </svg>
      </button>
    )}
  </div>
</nav>
