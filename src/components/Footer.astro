<footer class="border-t border-[var(--border-color)] bg-[var(--bg-primary)] px-5 pt-16 pb-12">
  <div class="mx-auto max-w-[1200px]">
    <div class="grid gap-10 sm:grid-cols-2 md:grid-cols-4 pb-12 border-b border-[var(--border-color)]">
      <!-- Col 1: Brand & Purpose -->
      <div class="space-y-3">
        <a href="/" class="flex items-center gap-2 text-[var(--text-primary)] no-underline">
          <span
            class="flex h-7 w-7 items-center justify-center rounded-[7px] bg-[var(--text-primary)] text-[var(--bg-primary)] transition-colors shadow-xs"
            aria-hidden="true"
          >
            <svg width="15" height="15" viewBox="0 0 512 512" fill="none" stroke="currentColor">
              <line x1="168" y1="126" x2="112" y2="182" stroke-width="40" stroke-linecap="round" />
              <line x1="344" y1="126" x2="400" y2="182" stroke-width="40" stroke-linecap="round" />
              <line x1="170" y1="355" x2="138" y2="387" stroke-width="40" stroke-linecap="round" />
              <line x1="342" y1="355" x2="374" y2="387" stroke-width="40" stroke-linecap="round" />
              <circle cx="256" cy="270" r="114" stroke-width="40" />
              <path d="M256 205 V270 L292 304" stroke-width="40" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <p class="text-[15px] font-semibold tracking-tight">FreeExamTimer</p>
        </a>
        <p class="max-w-sm text-sm leading-5 text-[var(--text-secondary)]">
          A hall-ready exam clock built for teachers, invigilators, and students. Reading time, +25% extra time access arrangements, and projector hall mode — 100% free with no ads.
        </p>
        <div class="inline-flex items-center gap-1.5 text-xs text-[var(--text-muted)] font-mono">
          <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
          <span>Zero Tracking • No Ads • Offline Safe</span>
        </div>
      </div>

      <!-- Col 2: App & Guides -->
      <div>
        <p class="eyebrow mb-3">Timer & Guides</p>
        <ul class="space-y-2 text-sm text-[var(--text-secondary)]">
          <li><a href="/" class="transition-colors hover:text-[var(--text-primary)]">Exam Timer</a></li>
          <li><a href="/how-to" class="transition-colors hover:text-[var(--text-primary)]">How to Use</a></li>
          <li><a href="/faq" class="transition-colors hover:text-[var(--text-primary)]">FAQ & Help</a></li>
        </ul>
      </div>

      <!-- Col 3: Company & Support -->
      <div>
        <p class="eyebrow mb-3">About & Contact</p>
        <ul class="space-y-2 text-sm text-[var(--text-secondary)]">
          <li><a href="/about" class="transition-colors hover:text-[var(--text-primary)]">About Us</a></li>
          <li><a href="/contact" class="transition-colors hover:text-[var(--text-primary)]">Contact Us</a></li>
          <li><a href="/how-to" class="transition-colors hover:text-[var(--text-primary)]">Hall Projections</a></li>
        </ul>
      </div>

      <!-- Col 4: Legal & Policies -->
      <div>
        <p class="eyebrow mb-3">Legal</p>
        <ul class="space-y-2 text-sm text-[var(--text-secondary)]">
          <li><a href="/privacy" class="transition-colors hover:text-[var(--text-primary)]">Privacy Policy</a></li>
          <li><a href="/terms" class="transition-colors hover:text-[var(--text-primary)]">Terms & Conditions</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom utility & action bar -->
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[var(--text-muted)]">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <p>© 2026 FreeExamTimer. All rights reserved.</p>
        <span class="hidden sm:inline opacity-30">•</span>
        <p class="hidden md:inline">Shortcuts: <kbd>Space</kbd> Start/Pause · <kbd>R</kbd> Reset · <kbd>F</kbd> Fullscreen · <kbd>D</kbd> Theme</p>
      </div>

      <!-- Footer Buttons -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          data-theme-toggle
          class="btn-app h-8 px-3 py-1 text-xs flex items-center gap-1.5 cursor-pointer"
          title="Toggle dark/light mode"
          aria-label="Toggle theme"
        >
          <svg class="theme-icon-sun hidden" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="5"></circle>
            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
          </svg>
          <svg class="theme-icon-moon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <span>Theme: <span data-theme-label>Light</span></span>
        </button>

        <button
          type="button"
          id="btn-back-to-top"
          class="btn-app h-8 px-3 py-1 text-xs flex items-center gap-1.5 cursor-pointer"
          title="Scroll to top of page"
          aria-label="Back to top"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m18 15-6-6-6 6"></path>
          </svg>
          <span>Top</span>
        </button>
      </div>
    </div>
  </div>
</footer>
