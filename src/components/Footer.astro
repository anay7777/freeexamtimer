---
import { languages, type Lang } from '../i18n/ui';
import { getLangFromUrl, getAlternatePath, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<footer class="border-t border-[var(--border-color)] bg-[var(--bg-primary)] px-5 pt-16 pb-12">
  <div class="mx-auto max-w-[1200px]">
    <div class="grid gap-10 sm:grid-cols-2 md:grid-cols-4 pb-12 border-b border-[var(--border-color)]">
      <!-- Col 1: Brand & Purpose -->
      <div class="space-y-3">
        <a href={translatePath('/')} class="flex items-center gap-2 text-[var(--text-primary)] no-underline">
          <span
            class="flex h-7 w-7 items-center justify-center rounded-[7px] bg-[var(--text-primary)] text-[var(--bg-primary)] transition-colors shadow-xs"
            aria-hidden="true"
          >
            <svg width="15" height="15" viewBox="0 0 512 512" fill="none" stroke="currentColor">
              <line x1="168" y1="126" x2="112" y2="182" stroke-width="40" stroke-linecap="round" />
              <line x1="344" y1="126" x2="400" y2="182" stroke-width="40" stroke-linecap="round" />
              <line x1="170" y1="355" x2="138" y2="387" stroke-width="40" stroke-linecap="round" />
              <line x1="342" y1="355" x2="374" y2="387" stroke-width="40" stroke-linecap="round" />
              <circle cx="256" cy="270" r="114" stroke-width="40" />
              <path d="M256 205 V270 L292 304" stroke-width="40" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <p class="text-[15px] font-semibold tracking-tight">FreeExamTimer</p>
        </a>
        <p class="max-w-sm text-sm leading-5 text-[var(--text-secondary)]">
          {t.footer.tagline}
        </p>
        <div class="inline-flex items-center gap-1.5 text-xs text-[var(--text-muted)] font-mono">
          <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
          <span>{t.footer.badges}</span>
        </div>
      </div>

      <!-- Col 2: App & Guides -->
      <div>
        <p class="eyebrow mb-3">{t.footer.timerGuides}</p>
        <ul class="space-y-2 text-sm text-[var(--text-secondary)]">
          <li><a href={translatePath('/')} class="transition-colors hover:text-[var(--text-primary)]">{t.footer.examTimer}</a></li>
          <li><a href={translatePath('/how-to/')} class="transition-colors hover:text-[var(--text-primary)]">{t.footer.howToUse}</a></li>
          <li><a href={translatePath('/faq/')} class="transition-colors hover:text-[var(--text-primary)]">{t.footer.faqHelp}</a></li>
        </ul>
      </div>

      <!-- Col 3: Company & Support (English-only pages) -->
      <div>
        <p class="eyebrow mb-3">{t.footer.aboutContact}</p>
        <ul class="space-y-2 text-sm text-[var(--text-secondary)]">
          <li><a href="/about" class="transition-colors hover:text-[var(--text-primary)]">{t.footer.aboutUs}</a></li>
          <li><a href="/contact" class="transition-colors hover:text-[var(--text-primary)]">{t.footer.contactUs}</a></li>
          <li><a href={translatePath('/how-to/')} class="transition-colors hover:text-[var(--text-primary)]">{t.footer.hallProjections}</a></li>
        </ul>
      </div>

      <!-- Col 4: Legal & Policies (English-only pages) -->
      <div>
        <p class="eyebrow mb-3">{t.footer.legal}</p>
        <ul class="space-y-2 text-sm text-[var(--text-secondary)]">
          <li><a href="/privacy" class="transition-colors hover:text-[var(--text-primary)]">{t.footer.privacy}</a></li>
          <li><a href="/terms" class="transition-colors hover:text-[var(--text-primary)]">{t.footer.terms}</a></li>
        </ul>
      </div>
    </div>

    <!-- Language links -->
    <nav class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs" aria-label={t.footer.languages}>
      <span class="eyebrow">{t.footer.languages}</span>
      {(Object.entries(languages) as [Lang, string][]).map(([code, label]) => (
        <a
          href={getAlternatePath(Astro.url, code)}
          hreflang={code}
          lang={code}
          aria-current={code === lang ? 'page' : undefined}
          class:list={[
            'transition-colors hover:text-[var(--text-primary)]',
            code === lang ? 'font-semibold text-[var(--text-primary)]' : 'text-[var(--text-secondary)]',
          ]}
        >
          {label}
        </a>
      ))}
    </nav>

    <!-- Bottom utility & action bar -->
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[var(--text-muted)]">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <p>{t.footer.rights}</p>
        <span class="hidden sm:inline opacity-30">•</span>
        <p class="hidden md:inline" set:html={t.footer.shortcuts} />
      </div>

      <!-- Footer Buttons -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          data-theme-toggle
          class="btn-app h-8 px-3 py-1 text-xs flex items-center gap-1.5 cursor-pointer"
          title={t.footer.themeTitle}
          aria-label={t.nav.toggleTheme}
        >
          <svg class="theme-icon-sun hidden" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="5"></circle>
            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
          </svg>
          <svg class="theme-icon-moon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <span>
            {t.footer.theme}
            <span data-theme-label data-label-dark={t.footer.dark} data-label-light={t.footer.light}>{t.footer.light}</span>
          </span>
        </button>

        <button
          type="button"
          id="btn-back-to-top"
          class="btn-app h-8 px-3 py-1 text-xs flex items-center gap-1.5 cursor-pointer"
          title={t.footer.topTitle}
          aria-label={t.footer.topAria}
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m18 15-6-6-6 6"></path>
          </svg>
          <span>{t.footer.top}</span>
        </button>
      </div>
    </div>
  </div>
</footer>
