---
import { languages, type Lang } from '../i18n/ui';
import { getLangFromUrl, getAlternatePath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<details class="lang-picker relative">
  <summary
    class="btn-app cursor-pointer list-none gap-1.5 px-2.5 [&::-webkit-details-marker]:hidden"
    title={t.nav.language}
    aria-label={t.nav.language}
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
    <span class="hidden text-xs font-semibold uppercase sm:inline">{lang}</span>
  </summary>
  <ul class="card absolute right-0 z-[110] mt-2 min-w-[168px] p-1 shadow-lg">
    {(Object.entries(languages) as [Lang, string][]).map(([code, label]) => (
      <li>
        <a
          href={getAlternatePath(Astro.url, code)}
          hreflang={code}
          lang={code}
          aria-current={code === lang ? 'page' : undefined}
          class:list={[
            'flex items-center justify-between rounded-[6px] px-3 py-2 text-sm transition-colors hover:bg-[var(--bg-elevated)]',
            code === lang ? 'font-semibold text-[var(--text-primary)]' : 'text-[var(--text-secondary)]',
          ]}
        >
          <span>{label}</span>
          <span class="font-mono text-[11px] uppercase text-[var(--text-muted)]">{code}</span>
        </a>
      </li>
    ))}
  </ul>
</details>

<script>
  // Close the language menu when clicking outside it or pressing Escape
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLDetailsElement>('details.lang-picker[open]').forEach((el) => {
      if (!el.contains(e.target as Node)) el.open = false;
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document.querySelectorAll<HTMLDetailsElement>('details.lang-picker[open]').forEach((el) => (el.open = false));
  });
</script>
