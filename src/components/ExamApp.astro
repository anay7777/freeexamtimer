              </label>
              <input class="field font-mono" id="input-autostart" type="time" />
              <p class="mt-1 text-[11px] text-[var(--text-muted)]">Starts automatically when wall clock hits this exact time.</p>
            </div>

            <div>
              <label class="mb-1.5 block text-[13px] font-medium text-[var(--text-secondary)]" for="input-instructions">
                Invigilator Notice / Rules for Screen
              </label>
              <textarea class="field min-h-[76px] resize-y" id="input-instructions" maxlength="400" placeholder="e.g. Silence at all times. Black ballpoint pen only. No mobile phones or smartwatches."></textarea>
            </div>
          </div>

          <!-- Quick rules insertion chips -->
          <div>
            <span class="text-xs text-[var(--text-muted)] block mb-1.5">Add common exam rules to instructions:</span>
            <div class="flex flex-wrap gap-1.5">
              <button class="chip-rule" type="button" data-add-rule="Silence at all times in the examination room.">+ Silence at all times</button>
              <button class="chip-rule" type="button" data-add-rule="All mobile phones and smartwatches must be switched off and placed in bags.">+ No phones / smartwatches</button>
              <button class="chip-rule" type="button" data-add-rule="Black ink or ballpoint pen only. Do not use correcting fluid.">+ Black pen only</button>
              <button class="chip-rule" type="button" data-add-rule="Check that you have the correct examination paper.">+ Check paper details</button>
              <button class="chip-rule" type="button" data-add-rule="Raise your hand if you require extra paper or assistance.">+ Raise hand for help</button>
            </div>
          </div>
        </div>
      </section>

      <!-- Why this is the best exam timer -->
      <section class="mt-14">
        <p class="eyebrow mb-2 text-center">Built specifically for real exam halls</p>
        <h2 class="text-center text-[28px] md:text-[32px] leading-tight font-semibold tracking-tight">
          Everything an invigilator needs — and nothing they don't
        </h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <article class="card p-5">
            <div class="flex items-center gap-2 mb-2">
              <span class="flex h-7 w-7 items-center justify-center rounded-md bg-[var(--bg-elevated)] border border-[var(--border-color)]">📘</span>
              <h3 class="text-base font-semibold">Reading then writing</h3>
            </div>
            <p class="text-xs md:text-sm leading-5 text-[var(--text-secondary)]">
              Optional reading time counts down first with clear instructions, then automatically hands over into writing time with an audible tone.
            </p>
          </article>

          <article class="card p-5">
            <div class="flex items-center gap-2 mb-2">
              <span class="flex h-7 w-7 items-center justify-center rounded-md bg-[var(--bg-elevated)] border border-[var(--border-color)]">⏱️</span>
              <h3 class="text-base font-semibold">Dual finish clocks</h3>
            </div>
            <p class="text-xs md:text-sm leading-5 text-[var(--text-secondary)]">
              Calculates both standard finish time and +25% access arrangement finish time side-by-side. No mental math on the whiteboard.
            </p>
          </article>

          <article class="card p-5">
            <div class="flex items-center gap-2 mb-2">
              <span class="flex h-7 w-7 items-center justify-center rounded-md bg-[var(--bg-elevated)] border border-[var(--border-color)]">📺</span>
              <h3 class="text-base font-semibold">Projector hall mode</h3>
            </div>
            <p class="text-xs md:text-sm leading-5 text-[var(--text-secondary)]">
              One-click full screen with giant tabular numerals readable from 30+ meters away at the back of the gym or assembly hall.
            </p>
          </article>

          <article class="card p-5">
            <div class="flex items-center gap-2 mb-2">
              <span class="flex h-7 w-7 items-center justify-center rounded-md bg-[var(--bg-elevated)] border border-[var(--border-color)]">🛡️</span>
              <h3 class="text-base font-semibold">Drift-free & crash-proof</h3>
            </div>
            <p class="text-xs md:text-sm leading-5 text-[var(--text-secondary)]">
              Uses system timestamp deltas, not fragile tick intervals. Accidental browser refresh or tab close restores the running exam instantly.
            </p>
          </article>

          <article class="card p-5">
            <div class="flex items-center gap-2 mb-2">
              <span class="flex h-7 w-7 items-center justify-center rounded-md bg-[var(--bg-elevated)] border border-[var(--border-color)]">🔔</span>
              <h3 class="text-base font-semibold">Synthesized chimes</h3>
            </div>
            <p class="text-xs md:text-sm leading-5 text-[var(--text-secondary)]">
              Synthesized via Web Audio API without external audio files. 15m, 10m, 5m, and 1m warnings, or silent hall visual flash.
            </p>
          </article>

          <article class="card p-5">
            <div class="flex items-center gap-2 mb-2">
              <span class="flex h-7 w-7 items-center justify-center rounded-md bg-[var(--bg-elevated)] border border-[var(--border-color)]">🔗</span>
              <h3 class="text-base font-semibold">Shareable exam links</h3>
            </div>
            <p class="text-xs md:text-sm leading-5 text-[var(--text-secondary)]">
              Encode paper name, length, reading time, and notices directly into a shareable URL to sync multiple examination rooms.
            </p>
          </article>
        </div>
      </section>
    </div>
  </main>

