---
import { MAJOR_COUNTRY_TIMEZONES } from '../data/timezones';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const regions = ['System', 'Asia & Pacific', 'Americas', 'Europe', 'Middle East & Africa'] as const;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const a = t.app;
const fmtN = (template: string, n: number) => template.replace('{n}', String(n));

// Runtime strings for src/scripts/exam-ui.ts; "<" is escaped so the JSON can't close the script tag
const clientStrings = JSON.stringify({ ...t.client, sounds: a.sounds }).replace(/</g, '\\u003c');
---

<div id="exam-app">
  <div class="backdrop" id="backdrop" aria-hidden="true"></div>

  <!-- Settings Drawer -->
  <aside class="settings-panel" id="settings-panel" aria-label={a.settings.ariaLabel}>
    <div class="flex items-center justify-between border-b border-[var(--border-color)] px-5 py-4">
      <div class="flex items-center gap-2">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83-2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
        <h2 class="text-base font-semibold">{a.settings.title}</h2>
      </div>
      <button class="btn-app h-8 w-8 min-h-0 min-w-0 p-0 text-xs" id="btn-close-settings" type="button" aria-label={a.settings.close}>✕</button>
    </div>
    <div class="flex flex-col gap-6 px-5 py-5 pb-24 md:pb-6">
      <section>
        <p class="eyebrow mb-3">{a.settings.displayClock}</p>
        <div class="flex flex-col gap-3">
          <div>
            <label class="mb-1.5 block text-[13px] text-[var(--text-muted)]" for="select-timezone-settings">
              {a.settings.countryTime}
            </label>
            <select id="select-timezone-settings" class="field text-xs sm:text-[13px] cursor-pointer">
              {regions.map((reg) => (
                <optgroup label={a.regions[reg]}>
                  {MAJOR_COUNTRY_TIMEZONES.filter((tz) => tz.region === reg).map((tz) => (
                    <option value={tz.id}>
                      {tz.flag} {tz.country} — {tz.abbr} ({tz.utcOffset})
                    </option>
                  ))}
                </optgroup>
              ))}
            </select>
            <p class="mt-1 text-[11px] text-[var(--text-muted)]">{a.settings.countryTimeHint}</p>
          </div>
          <label class="flex items-center justify-between text-sm text-[var(--text-secondary)]">
            <span>{a.settings.darkMode}</span>
            <span class="toggle"><input type="checkbox" id="toggle-dark" /><span></span></span>
          </label>
          <label class="flex items-center justify-between text-sm text-[var(--text-secondary)]">
            <span>{a.settings.alwaysSeconds}</span>
            <span class="toggle"><input type="checkbox" id="toggle-seconds" checked /><span></span></span>
          </label>
          <label class="flex items-center justify-between text-sm text-[var(--text-secondary)]" title={a.settings.hideSecondsTitle}>
            <span>{a.settings.hideSeconds} <span class="text-xs text-[var(--text-muted)]">{a.settings.calm}</span></span>
            <span class="toggle"><input type="checkbox" id="toggle-anxiety-seconds" /><span></span></span>
          </label>
          <label class="flex items-center justify-between text-sm text-[var(--text-secondary)]">
            <span>{a.settings.hour12}</span>
            <span class="toggle"><input type="checkbox" id="toggle-hour12" /><span></span></span>
          </label>
          <label class="flex items-center justify-between text-sm text-[var(--text-secondary)]">
            <span>{a.settings.showExtra}</span>
            <span class="toggle"><input type="checkbox" id="toggle-extra-clock" checked /><span></span></span>
          </label>
          <label class="flex items-center justify-between text-sm text-[var(--text-secondary)]">
            <span>{a.settings.flash}</span>
            <span class="toggle"><input type="checkbox" id="toggle-flash" checked /><span></span></span>
          </label>
          <label class="flex items-center justify-between text-sm text-[var(--text-secondary)]">
            <span>{a.settings.wakeLock}</span>
            <span class="toggle"><input type="checkbox" id="toggle-wakelock" checked /><span></span></span>
          </label>
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-[13px] text-[var(--text-muted)]">{a.settings.timerSize}</span>
              <span class="font-mono text-xs text-[var(--text-muted)]" id="label-size">100%</span>
            </div>
            <input type="range" id="range-size" min="70" max="150" value="100" aria-label={a.settings.timerSizeAria} />
          </div>
        </div>
      </section>

      <section>
        <p class="eyebrow mb-3">{a.settings.soundChimes}</p>
        <div class="flex flex-col gap-3">
          <label class="flex items-center justify-between text-sm text-[var(--text-secondary)]">
            <span>{a.settings.silent}</span>
            <span class="toggle"><input type="checkbox" id="toggle-silent" /><span></span></span>
          </label>
          <div>
            <label class="mb-1.5 block text-[13px] text-[var(--text-muted)]" for="select-sound">{a.settings.chimeSound}</label>
            <select id="select-sound" class="field">
              {Object.entries(a.sounds).map(([value, label]) => (
                <option value={value}>{label}</option>
              ))}
            </select>
          </div>
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-[13px] text-[var(--text-muted)]">{a.settings.volume}</span>
              <span class="font-mono text-xs text-[var(--text-muted)]" id="label-volume">70%</span>
            </div>
            <input type="range" id="range-volume" min="0" max="100" value="70" aria-label={a.settings.volume} />
          </div>
          <button class="btn-app w-full text-xs" id="btn-test-sound" type="button">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
              <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
            </svg>
            {a.settings.testSound}
          </button>
        </div>
      </section>

      <section>
        <p class="eyebrow mb-3">{a.settings.warnings}</p>
        <p class="mb-3 text-[13px] text-[var(--text-muted)]">{a.settings.warningsHint}</p>
        <div class="flex flex-col gap-2.5">
          <label class="flex items-center gap-2.5 text-sm text-[var(--text-secondary)]">
            <input type="checkbox" id="warn-30" /> {fmtN(a.settings.warnMinutes, 30)}
          </label>
          <label class="flex items-center gap-2.5 text-sm text-[var(--text-secondary)]">
            <input type="checkbox" id="warn-15" checked /> {fmtN(a.settings.warnMinutes, 15)}
          </label>
          <label class="flex items-center gap-2.5 text-sm text-[var(--text-secondary)]">
            <input type="checkbox" id="warn-10" /> {fmtN(a.settings.warnMinutes, 10)}
          </label>
          <label class="flex items-center gap-2.5 text-sm text-[var(--text-secondary)]">
            <input type="checkbox" id="warn-5" checked /> {fmtN(a.settings.warnMinutes, 5)}
          </label>
          <label class="flex items-center gap-2.5 text-sm text-[var(--text-secondary)]">
            <input type="checkbox" id="warn-1" checked /> {a.settings.warnOneMinute}
          </label>
        </div>
      </section>

      <section>
        <p class="eyebrow mb-3">{a.settings.shortcuts}</p>
        <div class="flex flex-col gap-2 text-[13px] text-[var(--text-secondary)]">
          <div class="flex justify-between items-center"><span>{a.settings.scStartPause}</span><kbd>Space</kbd></div>
          <div class="flex justify-between items-center"><span>{a.settings.scReset}</span><kbd>R</kbd></div>
          <div class="flex justify-between items-center"><span>{a.settings.scFullScreen}</span><kbd>F</kbd></div>
          <div class="flex justify-between items-center"><span>{a.settings.scTheme}</span><kbd>D</kbd></div>
          <div class="flex justify-between items-center"><span>{a.settings.scSettings}</span><kbd>S</kbd></div>
          <div class="flex justify-between items-center"><span>{a.settings.scExit}</span><kbd>Esc</kbd></div>
        </div>
      </section>
    </div>
  </aside>

  <!-- Fullscreen Hall Projection View -->
  <div id="fullscreen-overlay" aria-label={a.fullscreen.ariaLabel}>
    <div class="w-full max-w-5xl px-6 flex flex-col items-center">
      <div class="flex items-center gap-3">
        <span id="fs-phase-chip" class="badge-ready rounded-full px-3.5 py-1 text-xs font-semibold uppercase tracking-wider">{a.fullscreen.ready}</span>
        <span id="fs-extra-badge" class="hidden rounded-full bg-[#ffefcf] px-3 py-1 text-xs font-semibold text-[#ab570a]">{a.fullscreen.extended}</span>
      </div>

      <h2 class="mt-4 text-center text-xl md:text-2xl font-semibold tracking-tight text-[var(--text-primary)] min-h-7" id="fs-title"></h2>
      <p class="text-center text-sm text-[var(--text-muted)] min-h-5" id="fs-centre"></p>
      <p class="mt-1 text-center text-xs md:text-sm font-medium text-[var(--color-link)] min-h-5" id="fs-directive"></p>

      <!-- Giant Countdown Numbers -->
      <div
        id="fs-timer"
        class="timer-digit mt-6 text-center text-[clamp(64px,16vw,190px)] leading-none font-semibold text-[var(--timer-text)] tracking-tight select-none"
      >
        01:00:00
      </div>

      <!-- Projector Progress Bar -->
      <div class="mt-6 w-full max-w-2xl">
        <div class="h-2 overflow-hidden rounded-full bg-[var(--border-color)]">
          <div id="fs-fill" class="h-full w-full bg-[var(--text-primary)] transition-[width] duration-200"></div>
        </div>
      </div>

      <!-- Hall Clocks Row -->
      <div class="mt-8 grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-8 w-full max-w-3xl text-center">
        <div class="card p-3 bg-[var(--bg-card)]">
          <p class="eyebrow flex items-center justify-center gap-1.5">
            <span>{a.fullscreen.currentTime}</span>
            <span id="fs-current-badge" class="rounded px-1.5 py-0.5 bg-[var(--border-color)] text-[10px] font-mono text-[var(--text-secondary)]">LOCAL</span>
          </p>
          <p class="mt-1 font-mono text-base md:text-xl font-medium" id="fs-current">—</p>
        </div>
        <div class="card p-3 bg-[var(--bg-card)]">
          <p class="eyebrow flex items-center justify-center gap-1.5">
            <span>{a.fullscreen.startTime}</span>
            <span id="fs-start-badge" class="rounded px-1.5 py-0.5 bg-[var(--border-color)] text-[10px] font-mono text-[var(--text-secondary)]">LOCAL</span>
          </p>
          <p class="mt-1 font-mono text-base md:text-xl font-medium" id="fs-start">—</p>
        </div>
        <div class="card p-3 bg-[var(--bg-card)]">
          <p class="eyebrow flex items-center justify-center gap-1.5">
            <span>{a.fullscreen.finishTime}</span>
            <span id="fs-finish-badge" class="rounded px-1.5 py-0.5 bg-[var(--border-color)] text-[10px] font-mono text-[var(--text-secondary)]">LOCAL</span>
          </p>
          <p class="mt-1 font-mono text-base md:text-xl font-medium" id="fs-finish">—</p>
        </div>
        <div class="card p-3 bg-[var(--bg-card)]" id="fs-box-extra-finish">
          <p class="eyebrow flex items-center justify-center gap-1.5 text-[#ab570a] dark:text-[#f7b750]">
            <span>{a.fullscreen.extraFinish}</span>
            <span id="fs-extra-finish-badge" class="rounded px-1.5 py-0.5 bg-[#ffefcf] dark:bg-[#38260b] text-[10px] font-mono text-[#ab570a] dark:text-[#f7b750]">LOCAL</span>
          </p>
          <p class="mt-1 font-mono text-base md:text-xl font-medium text-[#ab570a] dark:text-[#f7b750]" id="fs-extra-finish">—</p>
        </div>
      </div>

      <!-- Fullscreen country time badge & selector -->
      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        <div class="flex items-center gap-1.5 rounded-full border border-[var(--border-color)] bg-[var(--bg-card)] px-3 py-1 text-xs text-[var(--text-secondary)] font-mono shadow-xs">
          <span id="fs-tz-flag">🌐</span>
          <span id="fs-tz-label">{a.fullscreen.localTime}</span>
        </div>
        <select id="fs-select-timezone" class="h-7 rounded-full border border-[var(--border-color)] bg-[var(--bg-card)] px-2.5 text-xs text-[var(--text-secondary)] font-medium outline-none cursor-pointer max-w-[220px] truncate" title={a.fullscreen.switchTzTitle}>
          {regions.map((reg) => (
            <optgroup label={a.regions[reg]}>
              {MAJOR_COUNTRY_TIMEZONES.filter((tz) => tz.region === reg).map((tz) => (
                <option value={tz.id}>
                  {tz.flag} {tz.country} ({tz.abbr})
                </option>
              ))}
            </optgroup>
          ))}
        </select>
      </div>

      <!-- Instructions banner in fullscreen -->
      <div id="fs-instructions-wrap" class="mt-6 w-full max-w-2xl hidden">
        <div class="rounded-lg border border-[var(--border-color)] bg-[var(--bg-card)] p-3 text-center text-sm text-[var(--text-secondary)] font-medium">
          <span class="mr-1.5">📌</span> <span id="fs-instructions-text"></span>
        </div>
      </div>

      <!-- Floating Controls on Hover -->
      <div id="fs-controls-wrap" class="mt-10 flex flex-wrap justify-center gap-2.5">
        <button class="btn-app btn-app-primary px-5" id="fs-btn-start" type="button">{a.controls.startExam}</button>
        <button class="btn-app px-4 hidden" id="fs-btn-pause" type="button">{a.controls.pause}</button>
        <button class="btn-app px-4 hidden" id="fs-btn-add-5" type="button">{a.controls.add5}</button>
        <button class="btn-app px-4" id="fs-btn-reset" type="button">{a.controls.reset}</button>
        <button class="btn-app px-4" id="fs-btn-exit" type="button" aria-label={a.fullscreen.exitAria}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"></path>
          </svg>
          {a.fullscreen.exit}
        </button>
      </div>
    </div>
  </div>

  <!-- Main Web Content -->
  <main class="hero-mesh min-h-screen pt-14 pb-[96px] md:pb-12">
    <div class="relative z-[1] mx-auto max-w-[960px] px-4 pt-6 pb-16 md:px-6 md:pt-10">
      
      <!-- Header eyebrow & Intro -->
      <div class="text-center md:text-left">
        <div class="inline-flex items-center gap-2 rounded-full border border-[var(--border-color)] bg-[var(--bg-elevated)] px-3 py-1 text-xs font-mono text-[var(--text-muted)]">
          <span class="inline-block h-2 w-2 rounded-full bg-[#50e3c2]"></span>
          {a.hero.badge}
        </div>
        <h1 class="mt-3 text-[32px] leading-[36px] font-semibold tracking-[-1.5px] sm:text-4xl md:text-5xl md:leading-tight">
          {a.hero.title}
        </h1>
        <p class="mt-2.5 max-w-2xl text-sm md:text-base leading-6 text-[var(--text-secondary)]">
          {a.hero.intro}
        </p>
      </div>

      <!-- Primary Timer Display Card -->
      <section id="display-card" class="card mt-6 p-5 md:p-8 text-center shadow-xs">
        <div class="flex flex-wrap items-center justify-center gap-2">
          <span id="phase-chip" class="badge-ready rounded-full px-3.5 py-1 text-xs font-semibold uppercase tracking-wider">
            {a.display.readyToStart}
          </span>
          <span id="extra-badge" class="hidden rounded-full bg-[#ffefcf] px-3 py-1 text-xs font-semibold text-[#ab570a]">
            {a.fullscreen.extended}
          </span>
        </div>

        <p id="display-title" class="mt-3 min-h-5 text-base md:text-lg font-semibold text-[var(--text-primary)]"></p>
        <p id="display-centre" class="text-xs text-[var(--text-muted)] min-h-4"></p>
        <p id="phase-directive" class="mt-1 text-xs md:text-sm font-medium text-[var(--color-link)] min-h-5">
          {a.display.directive}
        </p>

        <!-- Giant Timer Readout -->
        <div
          id="timer-display"
          class="timer-digit mt-5 text-[clamp(52px,13vw,104px)] leading-none font-semibold text-[var(--timer-text)] tracking-tight select-none"
        >
          01:00:00
        </div>

        <!-- Progress bar -->
        <div class="mx-auto mt-6 h-1.5 max-w-lg overflow-hidden rounded-full bg-[var(--border-color)]">
          <div id="progress-fill" class="h-full w-full bg-[var(--text-primary)] transition-[width] duration-200"></div>
        </div>

        <!-- 4 Clocks Grid (Live wall clock, Start, Standard finish, +25% extra finish) -->
        <div class="mt-7 grid grid-cols-2 gap-2.5 sm:grid-cols-4 md:gap-3 text-center">
          <div class="rounded-lg border border-[var(--border-color)] bg-[var(--bg-elevated)] p-2.5">
            <p class="eyebrow flex items-center justify-center gap-1">
              <span>{a.display.current}</span>
              <span id="clock-current-badge" class="rounded px-1.5 py-0.2 bg-[var(--border-color)] text-[10px] font-mono font-medium text-[var(--text-secondary)]">LOCAL</span>
            </p>
            <p id="clock-current" class="mt-1 font-mono text-sm md:text-base font-medium">—</p>
          </div>
          <div class="rounded-lg border border-[var(--border-color)] bg-[var(--bg-elevated)] p-2.5">
            <p class="eyebrow flex items-center justify-center gap-1">
              <span>{a.display.start}</span>
              <span id="clock-start-badge" class="rounded px-1.5 py-0.2 bg-[var(--border-color)] text-[10px] font-mono font-medium text-[var(--text-secondary)]">LOCAL</span>
            </p>
            <p id="clock-start" class="mt-1 font-mono text-sm md:text-base font-medium">—</p>
          </div>
          <div class="rounded-lg border border-[var(--border-color)] bg-[var(--bg-elevated)] p-2.5">
            <p class="eyebrow flex items-center justify-center gap-1">
              <span>{a.display.finish}</span>
              <span id="clock-finish-badge" class="rounded px-1.5 py-0.2 bg-[var(--border-color)] text-[10px] font-mono font-medium text-[var(--text-secondary)]">LOCAL</span>
            </p>
            <p id="clock-finish" class="mt-1 font-mono text-sm md:text-base font-medium">—</p>
          </div>
          <div class="rounded-lg border border-[var(--border-color)] bg-[var(--bg-elevated)] p-2.5" id="box-extra-finish">
            <p class="eyebrow flex items-center justify-center gap-1 text-[#ab570a] dark:text-[#f7b750]">
              <span>{a.display.extraFinish}</span>
              <span id="clock-extra-finish-badge" class="rounded px-1.5 py-0.2 bg-[#ffefcf] dark:bg-[#38260b] text-[10px] font-mono font-medium text-[#ab570a] dark:text-[#f7b750]">LOCAL</span>
            </p>
            <p id="clock-extra-finish" class="mt-1 font-mono text-sm md:text-base font-medium text-[#ab570a] dark:text-[#f7b750]">—</p>
          </div>
        </div>

        <!-- Country Standard Timer Selector under Current Time view -->
        <div class="mt-3.5 flex flex-wrap items-center justify-between gap-2.5 rounded-lg border border-[var(--border-color)] bg-[var(--bg-elevated)] px-3.5 py-2 text-xs text-left" id="country-timer-bar">
          <div class="flex items-center gap-2">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-[var(--border-color)] text-xs" id="display-tz-flag">🌐</span>
            <div>
              <span class="font-medium text-[var(--text-secondary)]">{a.display.countryTimer}</span>
              <span id="display-tz-label" class="ml-1 font-semibold text-[var(--text-primary)]">{a.display.localDevice}</span>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <label for="select-timezone-clock" class="sr-only">{a.display.chooseTz}</label>
            <select id="select-timezone-clock" class="h-8 rounded-md border border-[var(--border-color)] bg-[var(--bg-card)] px-2.5 py-1 text-xs font-medium text-[var(--text-primary)] outline-none transition-colors focus:border-[var(--color-link)] cursor-pointer max-w-[260px] sm:max-w-[320px] truncate" title={a.display.selectTzTitle}>
              {regions.map((reg) => (
                <optgroup label={a.regions[reg]}>
                  {MAJOR_COUNTRY_TIMEZONES.filter((tz) => tz.region === reg).map((tz) => (
                    <option value={tz.id}>
                      {tz.flag} {tz.country} — {tz.abbr} ({tz.utcOffset})
                    </option>
                  ))}
                </optgroup>
              ))}
            </select>
          </div>
        </div>

        <!-- Active Instructions Callout -->
        <div id="instructions-callout" class="mt-5 hidden rounded-lg border border-[var(--border-color)] bg-[var(--bg-elevated)] p-3 text-left text-xs md:text-sm text-[var(--text-secondary)]">
          <div class="flex items-start gap-2">
            <span class="mt-0.5 text-base">📌</span>
            <div>
              <p class="font-semibold text-[var(--text-primary)]">{a.display.hallNotice}</p>
              <p id="instructions-live" class="mt-0.5 whitespace-pre-line"></p>
            </div>
          </div>
        </div>
      </section>

      <!-- Desktop Primary Action Toolbar -->
      <div
        class="card mt-4 hidden p-3 md:flex md:flex-wrap md:items-center md:justify-center md:gap-2.5"
        id="desktop-controls"
      >
        <button class="btn-pill min-w-[140px]" id="btn-start" type="button">{a.controls.startExam}</button>
        <button class="btn-app hidden" id="btn-pause" type="button">{a.controls.pause}</button>
        <button class="btn-app" id="btn-reset" type="button">{a.controls.reset}</button>
        <button class="btn-app hidden" id="btn-add-5" type="button" title={a.controls.add5Title}>{a.controls.add5}</button>
        <button class="btn-app hidden" id="btn-add-15" type="button" title={a.controls.add15Title}>{a.controls.add15}</button>
        <button class="btn-app hidden" id="btn-add-25pct" type="button" title={a.controls.add25Title}>{a.controls.add25}</button>
        <button class="btn-app" id="btn-hall-fullscreen" type="button" title={a.controls.fullScreenTitle}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
          </svg>
          {a.controls.fullScreen}
        </button>
        <button class="btn-app" id="btn-share" type="button" title={a.controls.shareTitle}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
          </svg>
          {a.controls.share}
        </button>
      </div>

      <!-- Exam Configuration & Setup Card -->
      <section class="card mt-4 p-5 md:p-6" id="setup-card">
        <div class="mb-4 flex items-center justify-between border-b border-[var(--border-color)] pb-3">
          <div class="flex items-center gap-2">
            <p class="eyebrow">{a.setup.heading}</p>
            <span class="text-xs text-[var(--text-muted)]">{a.setup.editable}</span>
          </div>
          <div class="flex items-center gap-2">
            <button class="btn-app h-7 min-h-0 px-2.5 text-xs text-[var(--text-secondary)] hover:text-[var(--text-primary)]" id="btn-clear-setup" type="button" title={a.setup.clearTitle}>{a.setup.clear}</button>
            <button class="btn-app h-7 min-h-0 px-2.5 text-xs" id="btn-toggle-setup" type="button">{a.setup.hide}</button>
          </div>
        </div>

        <div id="setup-body" class="flex flex-col gap-5">
          <!-- Title & Paper details -->
          <div class="grid gap-3 sm:grid-cols-2">
            <div>
              <label class="mb-1.5 block text-[13px] font-medium text-[var(--text-secondary)]" for="input-title">
                {a.setup.titleLabel}
              </label>
              <input class="field" id="input-title" type="text" maxlength="80" placeholder={a.setup.titlePlaceholder} />
            </div>
            <div>
              <label class="mb-1.5 block text-[13px] font-medium text-[var(--text-secondary)]" for="input-centre">
                {a.setup.centreLabel} <span class="font-normal text-[var(--text-muted)]">{a.setup.optional}</span>
              </label>
              <input class="field" id="input-centre" type="text" maxlength="80" placeholder={a.setup.centrePlaceholder} />
            </div>
          </div>

          <!-- Exam Length (Writing Time) & Presets -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label class="text-[13px] font-medium text-[var(--text-secondary)]">{a.setup.durationLabel}</label>
              <span class="text-xs text-[var(--text-muted)]">{a.setup.durationHint}</span>
            </div>
            <div class="grid grid-cols-3 gap-2">
              <div>
                <span class="text-xs text-[var(--text-muted)]">{a.setup.hours}</span>
                <input class="field mt-1 text-center font-mono text-base font-semibold" id="input-hours" type="number" min="0" max="12" value="1" />
              </div>
              <div>
                <span class="text-xs text-[var(--text-muted)]">{a.setup.minutes}</span>
                <input class="field mt-1 text-center font-mono text-base font-semibold" id="input-minutes" type="number" min="0" max="59" value="0" />
              </div>
              <div>
                <span class="text-xs text-[var(--text-muted)]">{a.setup.seconds}</span>
                <input class="field mt-1 text-center font-mono text-base font-semibold" id="input-seconds" type="number" min="0" max="59" value="0" />
              </div>
            </div>

            <!-- Fast Duration Presets -->
            <div class="mt-2.5 flex flex-wrap gap-1.5 items-center">
              <span class="text-xs text-[var(--text-muted)] mr-1">{a.setup.presets}</span>
              {Object.entries(a.setup.presetLabels).map(([mins, label]) => (
                <button class="btn-preset" type="button" data-preset={mins}>{label}</button>
              ))}
            </div>
          </div>

          <!-- Reading Time & Extra Time Row -->
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class="mb-1.5 block text-[13px] font-medium text-[var(--text-secondary)]" for="input-reading">
                {a.setup.readingLabel}
              </label>
              <input class="field font-mono" id="input-reading" type="number" min="0" max="60" value="0" />
              <div class="mt-2 flex flex-wrap gap-1.5">
                <button class="btn-preset" type="button" data-reading="0">{a.setup.none}</button>
                <button class="btn-preset" type="button" data-reading="5">{fmtN(a.setup.minLabel, 5)}</button>
                <button class="btn-preset" type="button" data-reading="10">{fmtN(a.setup.minLabel, 10)}</button>
                <button class="btn-preset" type="button" data-reading="15">{fmtN(a.setup.minLabel, 15)}</button>
              </div>
              <p class="mt-1 text-[11px] text-[var(--text-muted)]">{a.setup.readingHint}</p>
            </div>

            <div>
              <label class="mb-1.5 block text-[13px] font-medium text-[var(--text-secondary)]" for="input-extra">
                {a.setup.extraLabel}
              </label>
              <input class="field font-mono" id="input-extra" type="number" min="0" max="180" value="0" />
              <div class="mt-2 flex flex-wrap gap-1.5 items-center">
                <button class="btn-preset" type="button" data-extra="0">{a.setup.none}</button>
                <button class="btn-preset" type="button" data-extra="5">+5m</button>
                <button class="btn-preset" type="button" data-extra="15">+15m</button>
                <button class="btn-preset font-sans" type="button" id="btn-calc-25pct" title={a.setup.calc25Title}>{a.setup.calc25}</button>
              </div>
              <p class="mt-1 text-[11px] text-[var(--text-muted)]">{a.setup.extraHint}</p>
            </div>
          </div>

          <!-- Auto start & Notice -->
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class="mb-1.5 block text-[13px] font-medium text-[var(--text-secondary)]" for="input-autostart">
                {a.setup.autostartLabel} <span class="font-normal text-[var(--text-muted)]">{a.setup.optional}</span>
              </label>
              <input class="field font-mono" id="input-autostart" type="time" />
              <p class="mt-1 text-[11px] text-[var(--text-muted)]">{a.setup.autostartHint}</p>

              <!-- Country Standard Time selection under Scheduled Start -->
              <div class="mt-3 rounded-lg border border-[var(--border-color)] bg-[var(--bg-elevated)] p-3">
                <div class="flex items-center justify-between mb-1.5">
                  <label class="text-[12px] font-medium text-[var(--text-secondary)] flex items-center gap-1.5" for="select-timezone-autostart">
                    <span>🌍</span>
                    <span>{a.setup.autostartTzLabel}</span>
                  </label>
                  <span id="autostart-tz-preview" class="font-mono text-[11px] font-medium text-[var(--color-link)] truncate"></span>
                </div>
                <select class="field font-sans text-xs" id="select-timezone-autostart">
                  {regions.map((reg) => (
                    <optgroup label={a.regions[reg]}>
                      {MAJOR_COUNTRY_TIMEZONES.filter((tz) => tz.region === reg).map((tz) => (
                        <option value={tz.id}>
                          {tz.flag} {tz.country} — {tz.abbr} ({tz.utcOffset})
                        </option>
                      ))}
                    </optgroup>
                  ))}
                </select>
                <p class="mt-1.5 text-[11px] leading-4 text-[var(--text-muted)]">
                  {a.setup.autostartTzHint}
                </p>
              </div>
            </div>

            <div>
              <label class="mb-1.5 block text-[13px] font-medium text-[var(--text-secondary)]" for="input-instructions">
                {a.setup.noticeLabel}
              </label>
              <textarea class="field min-h-[76px] resize-y" id="input-instructions" maxlength="400" placeholder={a.setup.noticePlaceholder}></textarea>
            </div>
          </div>

          <!-- Quick rules insertion chips -->
          <div>
            <span class="text-xs text-[var(--text-muted)] block mb-1.5">{a.setup.rulesHint}</span>
            <div class="flex flex-wrap gap-1.5">
              {a.setup.rules.map((rule) => (
                <button class="chip-rule" type="button" data-add-rule={rule.text}>{rule.label}</button>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- Why this is the best exam timer -->
      <section class="mt-14">
        <p class="eyebrow mb-2 text-center">{a.features.eyebrow}</p>
        <h2 class="text-center text-[28px] md:text-[32px] leading-tight font-semibold tracking-tight">
          {a.features.title}
        </h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {a.features.items.map((item) => (
            <article class="card p-5">
              <div class="flex items-center gap-2 mb-2">
                <span class="flex h-7 w-7 items-center justify-center rounded-md bg-[var(--bg-elevated)] border border-[var(--border-color)]">{item.icon}</span>
                <h3 class="text-base font-semibold">{item.title}</h3>
              </div>
              <p class="text-xs md:text-sm leading-5 text-[var(--text-secondary)]">
                {item.text}
              </p>
            </article>
          ))}
        </div>
      </section>

      <!-- ═══════════════════════════════════════════════
           SEO CONTENT ARTICLE — 800-1200 words
      ════════════════════════════════════════════════ -->
      <article class="mt-16 prose-section" id="about-exam-timer" aria-label={a.seo.ariaLabel}>

        <header class="text-center mb-10">
          <p class="eyebrow mb-2">{a.seo.eyebrow}</p>
          <h2 class="text-[28px] md:text-[34px] leading-tight font-semibold tracking-tight">
            {a.seo.title}
          </h2>
          <p class="mt-3 max-w-2xl mx-auto text-sm md:text-base leading-6 text-[var(--text-secondary)]" set:html={a.seo.intro} />
        </header>

        <div class="seo-grid">

          <section class="seo-block">
            <h3>{a.seo.what.title}</h3>
            {a.seo.what.paragraphs.map((html) => <p set:html={html} />)}
          </section>

          <section class="seo-block">
            <h3>{a.seo.core.title}</h3>
            <ul>
              {a.seo.core.items.map((html) => <li set:html={html} />)}
            </ul>
          </section>

          <section class="seo-block">
            <h3>{a.seo.competitive.title}</h3>
            <p set:html={a.seo.competitive.intro} />
            <ul>
              {a.seo.competitive.items.map((html) => <li set:html={html} />)}
            </ul>
          </section>

          <section class="seo-block">
            <h3>{a.seo.why.title}</h3>
            <p set:html={a.seo.why.intro} />
            <ul>
              {a.seo.why.items.map((html) => <li set:html={html} />)}
            </ul>
          </section>

          <section class="seo-block">
            <h3>{a.seo.howTo.title}</h3>
            <ol>
              {a.seo.howTo.steps.map((html) => <li set:html={html} />)}
            </ol>
          </section>

        </div>
      </article>

    </div>
  </main>

  <!-- Mobile Fixed Bottom Action Bar -->
  <nav
    class="fixed right-0 bottom-0 left-0 z-[90] border-t border-[var(--border-color)] bg-[var(--bg-primary)] px-3 pt-2 pb-[max(10px,env(safe-area-inset-bottom))] md:hidden"
    id="mobile-nav"
    aria-label={a.controls.mobileAria}
  >
    <div class="flex items-center gap-2">
      <button class="btn-app btn-app-primary flex-1 font-semibold" id="mob-start" type="button">{a.controls.startExam}</button>
      <button class="btn-app hidden flex-1 font-semibold" id="mob-pause" type="button">{a.controls.pause}</button>
      <button class="btn-app px-3" id="mob-reset" type="button">{a.controls.reset}</button>
      <button class="btn-app hidden px-3" id="mob-add" type="button" title={a.controls.mobileAdd5Title}>+5</button>
      <button class="btn-app px-3" id="mob-fullscreen" type="button" aria-label={a.controls.fullScreen}>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
        </svg>
      </button>
      <button class="btn-app px-3" id="mob-settings" type="button" aria-label={t.nav.settings}>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83-2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Toast notifications -->
  <div
    id="toast-container"
    class="pointer-events-none fixed bottom-20 left-1/2 z-[999] flex -translate-x-1/2 flex-col items-center gap-2"
  ></div>

  <!-- Reset Confirmation Modal -->
  <div
    id="reset-modal"
    class="fixed inset-0 z-[300] hidden items-center justify-center bg-black/60 p-4 backdrop-blur-xs"
  >
    <div class="card w-full max-w-sm p-6 shadow-xl animate-in fade-in duration-150">
      <div class="flex items-center gap-2.5 text-[#ee0000]">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
          <line x1="12" y1="9" x2="12" y2="13"></line>
          <line x1="12" y1="17" x2="12.01" y2="17"></line>
        </svg>
        <h2 class="text-lg font-semibold text-[var(--text-primary)]">{a.resetModal.title}</h2>
      </div>
      <p class="mt-2.5 text-sm text-[var(--text-secondary)]">
        {a.resetModal.text}
      </p>
      <div class="mt-6 flex gap-2.5">
        <button class="btn-app btn-app-primary flex-1 font-medium bg-[#ee0000] border-[#ee0000] text-white" id="confirm-reset" type="button">{a.resetModal.confirm}</button>
        <button class="btn-app flex-1" id="cancel-reset" type="button">{a.resetModal.cancel}</button>
      </div>
    </div>
  </div>

  <!-- Time is Up Modal -->
  <div
    id="done-modal"
    class="fixed inset-0 z-[300] hidden items-center justify-center bg-black/70 p-4 backdrop-blur-sm"
  >
    <div class="card w-full max-w-md p-8 text-center shadow-2xl animate-in zoom-in-95 duration-200">
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-[#ffe6e6] text-[#c50000] dark:bg-[#380707] dark:text-[#ff6b6b]">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
      </div>
      <p class="eyebrow mt-4 text-[#c50000] dark:text-[#ff6b6b]">{a.doneModal.eyebrow}</p>
      <h2 class="mt-1 text-2xl md:text-3xl font-bold tracking-tight text-[var(--text-primary)]" id="done-title">{a.doneModal.title}</h2>
      <p class="mt-2 text-sm text-[var(--text-secondary)]" id="done-sub">{a.doneModal.text}</p>
      <button class="btn-pill mt-6 w-full" id="dismiss-done" type="button">{a.doneModal.dismiss}</button>
    </div>
  </div>
</div>

<script id="exam-i18n" type="application/json" set:html={clientStrings} />

<script>
  import { bootExamUi } from '../scripts/exam-ui';
  bootExamUi();
</script>
