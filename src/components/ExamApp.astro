      <div class="mt-6 flex gap-2.5">
        <button class="btn-app btn-app-primary flex-1 font-medium bg-[#ee0000] border-[#ee0000] text-white" id="confirm-reset" type="button">Reset Exam</button>
        <button class="btn-app flex-1" id="cancel-reset" type="button">Cancel</button>
      </div>
    </div>
  </div>

  <!-- Time is Up Modal -->
